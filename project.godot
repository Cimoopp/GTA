; Настройки проекта "Mini GTA" (Godot 4.3+)
; Игра собирается в APK для Android.
config_version=5

[application]

config/name="Mini GTA"
config/description="3D мини-GTA: ходьба, машины, стрельба, пешеходы, миникарта"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"

[display]

; Базовое разрешение интерфейса (масштабируется под любой экран)
window/size/viewport_width=1280
window/size/viewport_height=720
; Экран телефона строго горизонтально (1 = landscape)
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

; ВАЖНО: касания НЕ превращаем в мышь — иначе любой тап по экрану
; считался бы выстрелом. Джойстик и кнопки работают напрямую.
pointing/emulate_mouse_from_touch=false

[physics]

common/physics_ticks_per_second=60

[rendering]

; Мобильный рендерер — быстрее и легче для Android
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=0
