; Настройки проекта "Mini GTA" (Godot 4.3+)
; Игра собирается в APK для Android и в веб-версию (браузер телефона/ПК).
config_version=5

[application]

config/name="Mini GTA"
config/description="3D мини-GTA: ходьба, машины, стрельба, пешеходы, миникарта"
run/main_scene="res://Main.tscn"
; Рендерер Compatibility — работает и на Android, и в браузере (WebGL2).
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[display]

; Базовое разрешение интерфейса (масштабируется под любой экран)
window/size/viewport_width=1280
window/size/viewport_height=720
; На телефоне экран строго горизонтально (1 = landscape)
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

; ВАЖНО: касания НЕ превращаем в мышь — иначе любой тап по экрану
; считался бы выстрелом. Джойстик и кнопки работают напрямую.
pointing/emulate_mouse_from_touch=false

[physics]

common/physics_ticks_per_second=60

[rendering]

; Compatibility — единственный рендерер, который работает в браузере,
; и самый лёгкий для телефонов.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
anti_aliasing/quality/msaa_3d=0

[debug]

; Строгие предупреждения GDScript не должны останавливать сборку (0 = игнорировать).
gdscript/warnings/inference_on_variant=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_cast=0
gdscript/warnings/unsafe_call_argument=0
gdscript/warnings/unsafe_void_return=0
gdscript/warnings/untyped_declaration=0
gdscript/warnings/return_value_discarded=0
